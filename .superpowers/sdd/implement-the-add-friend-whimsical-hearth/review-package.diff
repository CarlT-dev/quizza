+
+    // 8. friendships - one doc per pair; the doc id IS the sorted uids joined
+    // by _ (same convention as convos), so a request from A to B and from B
+    // to A can only ever land on one document.
+    match /friendships/{friendshipId} {
+      allow read: if request.auth != null &&
+        request.auth.uid in resource.data.participants;
+
+      allow create: if request.auth != null &&
+        request.resource.data.status == 'pending' &&
+        request.resource.data.requestedBy == request.auth.uid &&
+        request.resource.data.participants.size() == 2 &&
+        request.resource.data.participants[0] != request.resource.data.participants[1] &&
+        request.auth.uid in request.resource.data.participants &&
+        // Canonical id only: participants must be sorted and must equal the
+        // doc id, so no client can shadow the pair with a second document
+        request.resource.data.participants[0] < request.resource.data.participants[1] &&
+        friendshipId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1] &&
+        // Both sides must be real accounts (register always writes users/{uid})
+        exists(/databases/$(database)/documents/users/$(request.resource.data.participants[0])) &&
+        exists(/databases/$(database)/documents/users/$(request.resource.data.participants[1])) &&
+        // createdAt must be server-generated, not a client-forged timestamp
+        request.resource.data.createdAt == request.time;
+
+      // Status changes are one-way and requester-proof: only the participant
+      // who did NOT send the request may flip pending -> accepted, and
+      // participants/requestedBy/createdAt are immutable (mirrors the convos
+      // participants-immutability rule)
+      allow update: if request.auth != null &&
+        request.auth.uid in resource.data.participants &&
+        request.auth.uid != resource.data.requestedBy &&
+        resource.data.status == 'pending' &&
+        request.resource.data.participants == resource.data.participants &&
+        request.resource.data.requestedBy == resource.data.requestedBy &&
+        request.resource.data.createdAt == resource.data.createdAt &&
+        request.resource.data.status == 'accepted' &&
+        request.resource.data.respondedAt == request.time;
+
+      // Decline, cancel and unfriend are all deletes: either participant may
+      // remove the doc, which frees the pair id for a future re-request
+      allow delete: if request.auth != null &&
+        request.auth.uid in resource.data.participants;
+    }
   }
 }
