rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. usernames collection - public read for login
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. users collection - allow lookup by UID during login
    match /users/{userId} {
      allow get: if true;
      allow list: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. quizzes collection - owner-only access
    match /quizzes/{quizId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
    }

    // 4. quizPreferences collection - per-user color preferences
    match /quizPreferences/{prefId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null &&
        (resource == null || resource.data.userId == request.auth.uid);
    }

    // 5. quizTitles collection - per-user custom quiz titles
    match /quizTitles/{titleId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null &&
        (resource == null || resource.data.userId == request.auth.uid);
    }

    match /quizAttempts/{attemptId} {
      allow read: if request.auth != null &&
        (resource == null || resource.data.userId == request.auth.uid);

      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null &&
        (resource == null || resource.data.userId == request.auth.uid);
    }

    // 6. quizFavorites collection - star marking for the favorites-first sort
    match /quizFavorites/{favoriteId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null &&
        (resource == null || resource.data.userId == request.auth.uid);
    }
  }
}