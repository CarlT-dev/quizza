rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. usernames collection - public read for login
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. users collection - allow lookup by UID during login
    match /users/{userId} {
      allow get: if true;
      allow list: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. quizzes collection - owner access, plus recipients of a personal share
    match /quizzes/{quizId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
        (resource.data.createdBy == request.auth.uid ||
         request.auth.uid in resource.data.get('sharedWith', []));
      allow update, delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
    }

    // 4. quizPreferences collection - per-user color preferences
    match /quizPreferences/{prefId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null &&
        (resource == null || resource.data.userId == request.auth.uid);
    }

    // 5. quizTitles collection - per-user custom quiz titles
    match /quizTitles/{titleId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null &&
        (resource == null || resource.data.userId == request.auth.uid);
    }

    match /quizAttempts/{attemptId} {
      allow read: if request.auth != null &&
        (resource == null || resource.data.userId == request.auth.uid);

      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null &&
        (resource == null || resource.data.userId == request.auth.uid);
    }

    // 6. quizFavorites collection - star marking for the favorites-first sort
    match /quizFavorites/{favoriteId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null &&
        (resource == null || resource.data.userId == request.auth.uid);
    }

    // 7. convos - quiz shares between exactly two users
    match /convos/{convoId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participants;

      allow create: if request.auth != null &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.participants[0] != request.resource.data.participants[1] &&
        request.auth.uid in request.resource.data.participants;

      // Participants is immutable: membership changes only through the share
      // flow's own writes, never via client-sent updates (which could grant a
      // third uid read access to this convo)
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants;

      match /shares/{shareId} {
        allow read: if request.auth != null &&
          request.auth.uid in
          get(/databases/$(database)/documents/convos/$(convoId)).data.participants;

        // sharedBy is forged-proof: a participant can only send as themselves
        allow create: if request.auth != null &&
          request.resource.data.sharedBy == request.auth.uid &&
          request.auth.uid in
          get(/databases/$(database)/documents/convos/$(convoId)).data.participants;
      }
    }
  }
}